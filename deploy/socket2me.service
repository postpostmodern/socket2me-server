# Single Falcon instance, replacing the old socket2me@{5050..5053} template.
#
# Install:
#   sudo systemctl disable --now socket2me@5050 socket2me@5051 socket2me@5052 socket2me@5053
#   sudo rm /etc/systemd/system/socket2me@.service
#   sudo cp deploy/socket2me.service /etc/systemd/system/socket2me.service
#   # edit User/WorkingDirectory below to match the deploy
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now socket2me
#
# Then update nginx to the single upstream (see nginx/nginx.example.conf) and
# reload it.

[Unit]
Description=Socket2Me Falcon server
After=network.target

[Service]
Type=simple
User=socket2me
WorkingDirectory=/opt/socket2me-server
Environment=RACK_ENV=production
# Loopback bind + HTTP/1.1 (required for the WebSocket upgrade). --count 1 keeps
# a single reactor process so the in-memory registry/broker stay correct.
ExecStart=/usr/bin/env bundle exec falcon serve --bind http://127.0.0.1:5050 --count 1
Restart=on-failure
RestartSec=2

# Hardening (the app only needs to listen on loopback and read its own dir).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/socket2me-server/tmp

[Install]
WantedBy=multi-user.target
