# Copy to .kamal/env (gitignored) and fill in. Read by config/deploy.yml via ERB
# and sourced by .kamal/secrets, so infrastructure identifiers stay out of
# source control.
#
# QUOTE EVERY VALUE. Ruby's dotenv tolerates unquoted values containing spaces;
# POSIX shell sourcing does not, and OP_ITEM contains one.

# Host Kamal deploys to. Shared with exquisiteapp and apple_music_mcp.
DEPLOY_HOST="203.0.113.10"

# The BASE domain. Every user in config/users.yml becomes <user>.DEPLOY_DOMAIN.
#
# DNS: a wildcard A record (*.socket2me.dev → DEPLOY_HOST), and at Cloudflare it
# must stay DNS-only / grey-cloud — with the proxy on, Cloudflare terminates TLS
# and sees every token and payload. If the host has a public AAAA, the wildcard
# AAAA must point at it too, or Let's Encrypt validates against the wrong server.
DEPLOY_DOMAIN="socket2me.dev"

# GitHub username: the ghcr.io namespace and the registry login. The registry
# token is a PAT with `write:packages` — see .kamal/secrets.
REGISTRY_USER="your-github-user"

# 1Password account UUID (`op account list`) and the item holding
# KAMAL_REGISTRY_PASSWORD and S2M_USERS.
OP_ACCOUNT="your-account-uuid"
OP_ITEM="Vault/Item Name"
