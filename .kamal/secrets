# Shell, evaluated by Kamal at deploy time. Values are pulled live from
# 1Password, so no credential is ever written to disk in this repo — which is
# why this file is safe to commit.
#
# It sources .kamal/env itself rather than relying on config/deploy.yml having
# loaded it first: Kamal's ordering between reading secrets and evaluating
# deploy.yml is not something to depend on. (This is also why every value in
# .kamal/env must be quoted — POSIX sourcing does not tolerate unquoted spaces,
# and OP_ITEM contains one.)
set -a
. "$(dirname "${BASH_SOURCE[0]:-.kamal/secrets}")/env"
set +a

# KAMAL_REGISTRY_PASSWORD is a GitHub personal access token with `write:packages`
# (the registry is ghcr.io) — not a GitHub password and not a Docker Hub token.
#
# S2M_USERS is "user:token,user:token" — mint entries with bin/new-user. Its keys
# must equal config/users.yml exactly or the app refuses to serve and the deploy
# fails its healthcheck.
#
# The 1Password desktop app must be UNLOCKED. If it locks mid-deploy you get
# "sign_and_send_pubkey: signing failed ... communication with agent failed" —
# that is the 1Password SSH agent refusing to sign, not a Kamal fault.
SECRETS=$(kamal secrets fetch --adapter 1password --account ${OP_ACCOUNT} --from "${OP_ITEM}" KAMAL_REGISTRY_PASSWORD S2M_USERS)
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})
S2M_USERS=$(kamal secrets extract S2M_USERS ${SECRETS})
